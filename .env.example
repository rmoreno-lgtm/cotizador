# Introducir valores en Variables de Railway. No subir un .env con valores.
APP_SECRET=
# Opcionales: contraseña de acceso distinta de la llave interna. Mínimo 12 caracteres.
APP_USERNAME=quillum
APP_PASSWORD=
GNP_USERNAME=
GNP_PASSWORD=
DATA_DIR=/data
# Solo si los selectores automáticos no identifican un único campo:
GNP_USERNAME_SELECTOR=
GNP_PASSWORD_SELECTOR=
GNP_SUBMIT_SELECTOR=
